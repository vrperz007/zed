    {
      "id": "advanced",
      "label": "Advanced",
      "metrics": [
        {
          "key": "bauerUnits",
          "label": "Bauer Units",
          "short": "Bauer units",
          "unit": "BU",
          "step": 0.1,
          "min": 5,
          "max": 45,
          "decimals": 1,
          "better": "higher",
          "description": "Fastball spin rate divided by velocity (RPM ÷ MPH). Lets you compare spin between pitchers who throw at different speeds. Most fastballs land between 22 and 28."
        },
        {
          "key": "movementScore",
          "label": "Advanced Movement Score",
          "short": "Movement score",
          "unit": "",
          "step": 0.1,
          "min": 0,
          "max": 200,
          "decimals": 0,
          "better": "higher",
          "description": "Overall movement score from your tracking app. Enter it on the same scale the app uses (for example, 100 = average)."
        },
        {
          "key": "tilt",
          "label": "Measured Tilt",
          "short": "Tilt",
          "type": "tilt",
          "unit": "",
          "placeholder": "1:15",
          "description": "Spin axis shown as a clock face, measured from ball flight. 12:00 is pure backspin. Right-handed four-seamers usually sit near 12:30 to 1:30; lefties near 10:30 to 11:30."
        },
        {
          "key": "efficiency",
          "label": "Spin Efficiency",
          "short": "Efficiency",
          "unit": "%",
          "step": 0.1,
          "min": 0,
          "max": 100,
          "decimals": 0,
          "better": "higher",
          "description": "Share of total spin that creates movement (transverse spin). 100% means the pitch has no gyro spin."
        },
        {
          "key": "gyroAngle",
          "label": "Gyro Angle",
          "short": "Gyro",
          "unit": "°",
          "step": 0.1,
          "min": 0,
          "max": 90,
          "decimals": 0,
          "better": "neutral",
          "description": "Angle between the spin axis and the direction of flight. 0° is pure backspin or topspin; 90° is pure bullet spin. The right number depends on the pitch."
        }
      ]
    }
  ],
