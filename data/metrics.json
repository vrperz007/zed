      "id": "fastball",
      "label": "Fastball",
      "metrics": [
        {
          "key": "fbMaxVelo",
          "label": "Max Fastball Velocity",
          "short": "Max velo",
          "unit": "mph",
          "step": 0.1,
          "min": 40,
          "max": 110,
          "decimals": 1,
          "better": "higher",
          "description": "Fastest fastball of the session, from the radar or tracking unit."
        },
        {
          "key": "fbAvgVelo",
          "label": "Avg Fastball Velocity",
          "short": "Avg velo",
          "unit": "mph",
          "step": 0.1,
          "min": 40,
          "max": 110,
          "decimals": 1,
          "better": "higher",
          "description": "Average velocity across every fastball thrown in the session."
        },
        {
          "key": "fbMaxSpin",
          "label": "Max Fastball Spin Rate",
          "short": "FB spin",
          "unit": "rpm",
          "step": 1,
          "min": 500,
          "max": 3800,
          "decimals": 0,
          "better": "higher",
          "description": "Highest fastball spin rate recorded, in revolutions per minute."
        },
        {
          "key": "ivb",
          "label": "Induced Vertical Break",
          "short": "IVB",
          "unit": "in",
          "step": 0.1,
          "min": -30,
          "max": 30,
          "decimals": 1,
          "better": "higher",
          "description": "How much the fastball rides compared with a pitch thrown with no spin, in inches. More IVB means more carry through the top of the zone."
        }
      ]
    },
